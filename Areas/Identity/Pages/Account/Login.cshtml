@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
}

<style>
    .login-wrapper {
        min-height: 70vh;
    }

    .login-card {
        border: 0;
        border-radius: 1rem;
        overflow: hidden;
    }

    .login-header {
        background: linear-gradient(135deg, #0d6efd 0%, #6610f2 100%);
        color: #fff;
        padding: 2rem 1.5rem;
        text-align: center;
    }

    .login-header h2 {
        font-weight: 700;
        margin-bottom: .25rem;
    }

    .login-header p {
        margin-bottom: 0;
        opacity: .9;
    }

    .login-icon {
        width: 64px;
        height: 64px;
        border-radius: 50%;
        background: rgba(255, 255, 255, .2);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 1rem;
    }

    .login-card .form-control {
        border-radius: .6rem;
    }

    .login-card .form-control:focus {
        box-shadow: 0 0 0 .2rem rgba(13, 110, 253, .15);
    }

    .login-submit {
        border-radius: .6rem;
        padding: .8rem;
        font-weight: 600;
    }
</style>

<div class="row justify-content-center align-items-center login-wrapper">
    <div class="col-12 col-md-8 col-lg-6 col-xl-5">
        <div class="card login-card shadow-lg">

            <div class="login-header">
                <div class="login-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32"
                         fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                        <path d="M8 1a2 2 0 0 1 2 2v4H6V3a2 2 0 0 1 2-2zm3 6V3a3 3 0 0 0-6 0v4a2 2 0 0 0-2 2v5a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2z" />
                    </svg>
                </div>
                <h2>Welcome Back</h2>
                <p>Sign in to continue to your account.</p>
            </div>

            <div class="card-body p-4 p-md-5">
                <form id="account" method="post">
                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger py-2 small"
                         role="alert"></div>

                    <div class="form-floating mb-3">
                        <input asp-for="Input.Email"
                               class="form-control"
                               autocomplete="username"
                               aria-required="true"
                               placeholder="name@example.com" />
                        <label asp-for="Input.Email">Email</label>
                        <span asp-validation-for="Input.Email"
                              class="text-danger small"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="Input.Password"
                               class="form-control"
                               autocomplete="current-password"
                               aria-required="true"
                               placeholder="password" />
                        <label asp-for="Input.Password">Password</label>
                        <span asp-validation-for="Input.Password"
                              class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div class="form-check">
                            <input class="form-check-input" asp-for="Input.RememberMe" />
                            <label class="form-check-label" asp-for="Input.RememberMe">
                                @Html.DisplayNameFor(m => m.Input.RememberMe)
                            </label>
                        </div>

                        <a id="forgot-password"
                           asp-page="./ForgotPassword"
                           class="small">
                            Forgot your password?
                        </a>
                    </div>

                    <button id="login-submit"
                            type="submit"
                            class="btn btn-primary w-100 login-submit">
                        Log in
                    </button>

                    <p class="text-center text-muted small mt-4 mb-0">
                        Don't have an account?
                        <a asp-controller="Registration" asp-action="Create">Register</a>
                    </p>
                </form>

                @if ((Model.ExternalLogins?.Count ?? 0) > 0)
                {
                    <hr class="my-4" />

                    <form id="external-account"
                          asp-page="./ExternalLogin"
                          asp-route-returnUrl="@Model.ReturnUrl"
                          method="post">
                        <p class="text-center text-muted small mb-3">Or log in using</p>

                        <div class="d-grid gap-2">
                            @foreach (var provider in Model.ExternalLogins!)
                            {
                                <button type="submit"
                                        class="btn btn-outline-primary"
                                        name="provider"
                                        value="@provider.Name"
                                        title="Log in using your @provider.DisplayName account">
                                    @provider.DisplayName
                                </button>
                            }
                        </div>
                    </form>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
