@model IEnumerable<EducationalPlatform.ViewModels.QuizAssignmentListItem>
@{ ViewData["Title"] = "Quiz assignments"; }
<div class="container py-4"><div class="d-flex justify-content-between align-items-center mb-3"><div><h1>Quiz assignments &amp; attempts</h1><p class="text-muted">Assignments for your groups.</p></div><a class="btn btn-outline-secondary" asp-action="Index">Quizzes</a></div><div class="table-responsive"><table class="table table-striped align-middle"><thead><tr><th>Quiz</th><th>Year / group</th><th>Available period</th><th>Submissions</th><th></th></tr></thead><tbody>@foreach(var a in Model){<tr><td>@a.QuizTitle<div class="small text-muted">Max: @a.MaximumGrade</div></td><td>@a.YearName / @a.GroupName</td><td>@a.StartDateTime.ToString("dd MMM yyyy hh:mm tt")<br/>to @a.EndDateTime.ToString("dd MMM yyyy hh:mm tt")</td><td>@a.SubmittedCount / @a.StudentCount</td><td><a class="btn btn-sm btn-primary" asp-action="Attempts" asp-route-id="@a.Id">View attempts / grades</a></td></tr>}@if(!Model.Any()){<tr><td colspan="5" class="text-center text-muted">No quiz assignments yet.</td></tr>}</tbody></table></div></div>
