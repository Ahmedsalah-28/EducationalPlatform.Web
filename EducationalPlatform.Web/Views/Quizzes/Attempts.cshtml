@model EducationalPlatform.ViewModels.GradeQuizViewModel
@{ ViewData["Title"] = "Quiz attempts"; }
<div class="container py-4"><h1>Quiz attempts &amp; scores</h1><p class="text-muted">@Model.QuizTitle · @Model.YearName / @Model.GroupName · Maximum @Model.MaximumGrade</p><div class="alert alert-info">All active students in this group are listed. Enter a score to record the quiz result; leave it empty for students without a grade.</div><form asp-action="Attempts" method="post"><input asp-for="AssignmentId" type="hidden"/><div asp-validation-summary="All" class="text-danger"></div><div class="table-responsive"><table class="table table-striped align-middle"><thead><tr><th>Student</th><th>Started</th><th>Submitted</th><th>Score</th></tr></thead><tbody>@for(var i=0;i<Model.Students.Count;i++){<tr><td>@Model.Students[i].FullName<input asp-for="Students[i].AttemptId" type="hidden"/><input asp-for="Students[i].StudentId" type="hidden"/></td><td>@(Model.Students[i].StartedAt?.ToString("dd MMM yyyy hh:mm tt") ?? "—")</td><td>@(Model.Students[i].SubmittedAt?.ToString("dd MMM yyyy hh:mm tt") ?? "Not submitted")</td><td><input asp-for="Students[i].Score" class="form-control" type="number" min="0" max="@Model.MaximumGrade" step="0.01"/></td></tr>}@if(!Model.Students.Any()){<tr><td colspan="4" class="text-center text-muted">No active students in this group.</td></tr>}</tbody></table></div><button class="btn btn-primary" disabled="@(!Model.Students.Any())">Save scores</button> <a asp-action="Assignments" class="btn btn-outline-secondary">Back</a></form></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
