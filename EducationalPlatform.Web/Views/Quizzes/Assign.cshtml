@model EducationalPlatform.ViewModels.AssignQuizViewModel
@{ ViewData["Title"] = "Assign quiz"; }
<div class="container py-4"><h1>Assign quiz</h1><p class="text-muted">@Model.QuizTitle</p><form asp-action="Assign" method="post" class="card card-body gap-3"><input asp-for="QuizId" type="hidden"/><input asp-for="QuizTitle" type="hidden"/><div asp-validation-summary="All" class="text-danger"></div><div><label asp-for="YearId" class="form-label">Year</label><select asp-for="YearId" asp-items="Model.Years" class="form-select" id="yearSelect"><option value="">Choose year</option></select><span asp-validation-for="YearId" class="text-danger"></span></div><div><label asp-for="GroupId" class="form-label">Group</label><select asp-for="GroupId" asp-items="Model.Groups" class="form-select" id="groupSelect"><option value="">Choose group</option></select><span asp-validation-for="GroupId" class="text-danger"></span></div><div><label asp-for="StartDateTime" class="form-label">Available from</label><input asp-for="StartDateTime" type="datetime-local" class="form-control"/><span asp-validation-for="StartDateTime" class="text-danger"></span></div><div><label asp-for="EndDateTime" class="form-label">Available until</label><input asp-for="EndDateTime" type="datetime-local" class="form-control"/><span asp-validation-for="EndDateTime" class="text-danger"></span></div><div><button class="btn btn-primary">Assign quiz</button> <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a></div></form></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /><script>document.getElementById('yearSelect').addEventListener('change', async function(){const group=document.getElementById('groupSelect');group.innerHTML='<option value="">Choose group</option>';if(!this.value)return;const response=await fetch('@Url.Action("GetGroupsByYear", "Quizzes")?yearId='+encodeURIComponent(this.value));if(!response.ok)return;for(const item of await response.json()){const option=document.createElement('option');option.value=item.id;option.textContent=item.name;group.appendChild(option);}});</script> }
