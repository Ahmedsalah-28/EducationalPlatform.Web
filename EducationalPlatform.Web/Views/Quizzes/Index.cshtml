@model IEnumerable<EducationalPlatform.Models.Quiz>
@{ ViewData["Title"] = "Quizzes"; var counts = ViewBag.AssignmentCounts as IDictionary<int,int> ?? new Dictionary<int,int>(); }
<div class="container py-4"><div class="d-flex justify-content-between align-items-center mb-3"><div><h1>Quizzes</h1><p class="text-muted">Create quizzes and assign them to your groups.</p></div><div>@if (User.IsInRole("Assistant")) { <a class="btn btn-outline-secondary" asp-controller="Assistants" asp-action="Dashboard">Dashboard</a> } else { <a class="btn btn-outline-secondary" asp-controller="Admin" asp-action="Index">Dashboard</a> } <a class="btn btn-primary" asp-action="Create">Create quiz</a></div></div>@if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }@if (TempData["Error"] != null) { <div class="alert alert-warning">@TempData["Error"]</div> }<div class="mb-3"><a class="btn btn-outline-primary" asp-action="Assignments">View quiz assignments and attempts</a></div><div class="table-responsive"><table class="table table-striped align-middle"><thead><tr><th>Title</th><th>Maximum grade</th><th>Duration</th><th>Assignments</th><th></th></tr></thead><tbody>@foreach(var quiz in Model){<tr><td><strong>@quiz.Title</strong><div class="small text-muted">@quiz.Description</div></td><td>@quiz.MaximumGrade</td><td>@quiz.DurationMinutes min</td><td>@(counts.TryGetValue(quiz.Id,out var count)?count:0)</td><td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-action="Assign" asp-route-id="@quiz.Id">Assign</a> <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@quiz.Id">Edit</a></td></tr>}@if(!Model.Any()){<tr><td colspan="5" class="text-center text-muted py-4">No quizzes created yet.</td></tr>}</tbody></table></div></div>
