@model IEnumerable<EducationalPlatform.Models.ClassSession>

@{
    ViewData["Title"] = "Class Sessions Attendance";
}

<div class="mb-4">
    <a asp-action="GroupsByYear"
       asp-route-id="@ViewBag.YearId"
       class="btn btn-outline-secondary btn-sm mb-3">
        &larr; Back to Groups
    </a>

    <h2>Attendance — @ViewBag.YearName / @ViewBag.GroupName</h2>
    <p class="text-muted">
        Select a class session to record or update student attendance.
    </p>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">
        No class sessions have been created for this group yet.
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover table-striped align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Date</th>
                        <th>Start Time</th>
                        <th>End Time</th>
                        <th>Session Status</th>
                        <th>Attendance</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var session in Model)
                    {
                        <tr>
                            <td>@session.Date.ToString("yyyy-MM-dd")</td>
                            <td>@session.StartTime.ToString(@"hh\:mm")</td>
                            <td>@session.EndTime.ToString(@"hh\:mm")</td>
                            <td>
                                @if (session.Status == "Completed")
                                {
                                    <span class="badge bg-success">Completed</span>
                                }
                                else if (session.Status == "Cancelled")
                                {
                                    <span class="badge bg-danger">Cancelled</span>
                                }
                                else
                                {
                                    <span class="badge bg-primary">@session.Status</span>
                                }
                            </td>
                            <td>
                                @if (session.Status != "Cancelled")
                                {
                                    <a asp-action="Take"
                                       asp-route-id="@session.Id"
                                       class="btn btn-primary btn-sm">
                                        Take Attendance
                                    </a>
                                }
                                else
                                {
                                    <button class="btn btn-secondary btn-sm"
                                            disabled>
                                        Unavailable
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<div class="mt-3">
    <a asp-action="Index" class="btn btn-outline-secondary">
        All Years
    </a>
</div>