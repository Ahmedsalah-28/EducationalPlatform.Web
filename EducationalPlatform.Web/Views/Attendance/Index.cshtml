@model IEnumerable<EducationalPlatform.Models.Year>

@{
    ViewData["Title"] = "Attendance";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1">Attendance Management</h2>
        <p class="text-muted mb-0">Choose an academic year to continue.</p>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">
        No active academic years are available.
    </div>
}
else
{
    <div class="row">
        @foreach (var year in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@year.Name</h5>

                        <div style="min-height: 48px;">
                            @if (!string.IsNullOrWhiteSpace(year.Description))
                            {
                                <p class="text-muted">@year.Description</p>
                            }
                            else
                            {
                                <p>&nbsp;</p>
                            }
                        </div>

                        <div class="mt-auto">
                            <a asp-action="GroupsByYear"
                               asp-route-id="@year.Id"
                               class="btn btn-primary w-100">
                                <i class="bi bi-people"></i>
                                View Groups
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}