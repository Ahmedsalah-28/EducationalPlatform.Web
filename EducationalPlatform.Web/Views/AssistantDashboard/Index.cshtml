@model EducationalPlatform.ViewModels.AssistantDashboardViewModel
@{
    Layout = null;
    ViewData["Title"] = "Assistant Dashboard";
    var userName = Model.AssistantName;
    var initials = string.IsNullOrWhiteSpace(userName) ? "AS" : userName.Substring(0, Math.Min(2, userName.Length)).ToUpperInvariant();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/assistant-dashboard.css" asp-append-version="true" />
</head>
<body class="ad-body">
<div class="ad-shell">
    <aside class="ad-sidebar">
        <div class="ad-brand"><i class="bi bi-mortarboard-fill"></i><span>Edu Platform</span></div>
        <ul class="ad-nav">
            <li><a asp-controller="AssistantDashboard" asp-action="Index" class="active"><i class="bi bi-grid-1x2"></i> Dashboard</a></li>
            <li><a asp-controller="Attendance" asp-action="Index"><i class="bi bi-check2-square"></i> Attendance</a></li>
            <li><a asp-controller="Trainings" asp-action="Index"><i class="bi bi-journal-check"></i> Trainings</a></li>
            <li><a asp-controller="Trainings" asp-action="Assignments"><i class="bi bi-clipboard-check"></i> Training Grades</a></li>
            <li><a asp-controller="Exams" asp-action="Index"><i class="bi bi-file-earmark-text"></i> Exams</a></li>
            <li><a asp-controller="Exams" asp-action="Assignments"><i class="bi bi-calendar-event"></i> Exam Schedule &amp; Grades</a></li>
            <li><a asp-controller="Quizzes" asp-action="Index"><i class="bi bi-ui-checks"></i> Quizzes</a></li>
            <li><a asp-controller="Quizzes" asp-action="Assignments"><i class="bi bi-list-check"></i> Quiz Assignments</a></li>
        </ul>
        <form class="ad-logout" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post">
            <button type="submit"><i class="bi bi-box-arrow-right"></i> Logout</button>
        </form>
    </aside>
    <main class="ad-main">
        <div class="ad-topbar"><div class="ad-user"><div class="ad-avatar">@initials</div><div class="ad-user-meta"><div class="ad-user-name">@userName</div><div class="ad-user-role">Assistant</div></div></div></div>
        <section class="ad-welcome"><h1>Welcome back, @userName</h1><p>Here is an overview of your assigned years, groups, exams, and quizzes.</p></section>
        @if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
        @if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }
        <div class="ad-stats">
            <div class="ad-stat"><div class="ad-icon"><i class="bi bi-calendar3"></i></div><div class="ad-stat-label">Assigned Years</div><div class="ad-stat-num">@Model.TotalYears</div></div>
            <div class="ad-stat"><div class="ad-icon"><i class="bi bi-people"></i></div><div class="ad-stat-label">My Groups</div><div class="ad-stat-num">@Model.TotalGroups</div></div>
            <div class="ad-stat"><div class="ad-icon"><i class="bi bi-mortarboard"></i></div><div class="ad-stat-label">Active Students</div><div class="ad-stat-num">@Model.TotalStudents</div></div>
            <div class="ad-stat"><div class="ad-icon"><i class="bi bi-journal-check"></i></div><div class="ad-stat-label">Training Assignments</div><div class="ad-stat-num">@Model.TotalTrainings</div><a class="ad-link" asp-controller="Trainings" asp-action="Assignments">View →</a></div>
            <div class="ad-stat"><div class="ad-icon"><i class="bi bi-file-earmark-text"></i></div><div class="ad-stat-label">Exam Assignments</div><div class="ad-stat-num">@Model.TotalExams</div><a class="ad-link" asp-controller="Exams" asp-action="Assignments">View →</a></div>
            <div class="ad-stat"><div class="ad-icon"><i class="bi bi-ui-checks"></i></div><div class="ad-stat-label">Quiz Assignments</div><div class="ad-stat-num">@Model.TotalQuizzes</div><a class="ad-link" asp-controller="Quizzes" asp-action="Assignments">View →</a></div>
            <div class="ad-stat"><div class="ad-icon"><i class="bi bi-clipboard-data"></i></div><div class="ad-stat-label">Exam Results Pending</div><div class="ad-stat-num">@Model.PendingExamResults</div><a class="ad-link" asp-controller="Exams" asp-action="Assignments">Review →</a></div>
            <div class="ad-stat"><div class="ad-icon"><i class="bi bi-hourglass-split"></i></div><div class="ad-stat-label">Quiz Attempts Missing</div><div class="ad-stat-num">@Model.PendingQuizAttempts</div><a class="ad-link" asp-controller="Quizzes" asp-action="Assignments">Review →</a></div>
        </div>
        <section class="ad-panel">
            <div class="ad-panel-head"><h2>Upcoming Exams &amp; Quizzes</h2><a class="ad-link" asp-controller="Exams" asp-action="Assignments">All exams →</a></div>
            @if (!Model.UpcomingItems.Any()) { <p class="ad-empty">There are no upcoming exams or quizzes for your assigned groups.</p> }
            else { foreach (var item in Model.UpcomingItems) { <div class="ad-row"><div class="ad-icon sm"><i class="bi @(item.Kind == "Exam" ? "bi-file-earmark-text" : "bi-ui-checks")"></i></div><div class="ad-row-main"><div class="ad-row-title">@item.Title <span class="badge bg-light text-dark">@item.Kind</span></div><div class="ad-row-sub">@item.YearName · @item.GroupName</div></div><div class="ad-row-time"><i class="bi bi-calendar-event"></i> @item.Date.ToString("dd MMM yyyy") · @item.Time</div><a class="ad-btn" asp-controller="@item.Controller" asp-action="@(item.Kind == "Exam" ? "Grade" : "Attempts")" asp-route-id="@item.AssignmentId">Manage</a></div> } }
        </section>
    </main>
</div>
</body>
</html>
