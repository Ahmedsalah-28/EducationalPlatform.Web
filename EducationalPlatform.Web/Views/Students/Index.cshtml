@using Microsoft.AspNetCore.Mvc.Rendering
@model IEnumerable<EducationalPlatform.Models.Student>

@{
    ViewData["Title"] = "Students";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Students</h1>

    <a asp-action="Create" class="btn btn-primary">
        Add Student
    </a>
</div>

<form method="get" asp-action="Index" class="card card-body mb-4">
    <div class="row g-3 align-items-end">
        <div class="col-md-4">
            <label for="yearId" class="form-label">Year</label>
            <select id="yearId" name="yearId" class="form-select"
                    asp-items="(SelectList)ViewBag.Years"
                    onchange="document.getElementById('groupId').value = ''; this.form.submit();">
                <option value="">All years</option>
            </select>
        </div>

        <div class="col-md-4">
            <label for="groupId" class="form-label">Group</label>
            <select id="groupId" name="groupId" class="form-select"
                    asp-items="(SelectList)ViewBag.Groups"
                    onchange="this.form.submit();">
                <option value="">All groups</option>
            </select>
        </div>

        <div class="col-md-4">
            <a asp-action="Index" class="btn btn-outline-secondary">Clear filters</a>
            <span class="text-muted ms-2">@Model.Count() student(s)</span>
        </div>
    </div>
</form>

@if (!Model.Any())
{
    <div class="alert alert-info">
        @(ViewBag.SelectedYearId != null
            ? "No students match the selected filters."
            : "No students found.")
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-bordered table-striped align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Full Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Year</th>
                    <th>Group</th>
                    <th>Status</th>
                    <th>Joined At</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var student in Model)
                {
                    var activeEnrollment = student.Enrollments
                        .FirstOrDefault(e => e.Status == "Active");

                    <tr>
                        <td>@student.FullName</td>

                        <td>
                            @student.ApplicationUser.Email
                        </td>

                        <td>
                            @student.ApplicationUser.PhoneNumber
                        </td>

                        <td>
                            @(activeEnrollment?.Group?.Year?.Name ?? "-")
                        </td>

                        <td>
                            @(activeEnrollment?.Group?.Name ?? "-")
                        </td>

                        <td>
                            @if (student.Status == "Active")
                            {
                                <span class="badge bg-success">
                                    Active
                                </span>
                            }
                            else if (student.Status == "Suspended")
                            {
                                <span class="badge bg-warning text-dark">
                                    Suspended
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    @student.Status
                                </span>
                            }
                        </td>

                        <td>
                            @(activeEnrollment?.JoinedAt.ToString("yyyy-MM-dd") ?? "-")
                        </td>

                        <td>
                            <a asp-action="Details"
                               asp-route-id="@student.Id"
                               class="btn btn-sm btn-outline-primary">
                                Details
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}