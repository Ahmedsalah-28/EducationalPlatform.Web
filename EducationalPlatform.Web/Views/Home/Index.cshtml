@{
    ViewData["Title"] = "Welcome";
}

<style>
    .home-hero {
        background: linear-gradient(135deg, #0d6efd 0%, #6610f2 100%);
        color: #fff;
        border-radius: 1.25rem;
        padding: 4rem 1.5rem;
        position: relative;
        overflow: hidden;
    }

        .home-hero::before,
        .home-hero::after {
            content: "";
            position: absolute;
            border-radius: 50%;
            background: rgba(255, 255, 255, .08);
        }

        .home-hero::before {
            width: 320px;
            height: 320px;
            top: -120px;
            right: -80px;
        }

        .home-hero::after {
            width: 220px;
            height: 220px;
            bottom: -90px;
            left: -60px;
        }

        .home-hero > * {
            position: relative;
            z-index: 1;
        }

    .home-icon {
        width: 84px;
        height: 84px;
        border-radius: 50%;
        background: rgba(255, 255, 255, .2);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 1.25rem;
    }

    .home-btn {
        border-radius: .6rem;
        padding: .8rem 2rem;
        font-weight: 600;
        min-width: 160px;
    }

    .feature-card {
        border: 0;
        border-radius: 1rem;
        transition: transform .2s ease, box-shadow .2s ease;
    }

        .feature-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 .75rem 1.5rem rgba(0, 0, 0, .1) !important;
        }

    .feature-icon {
        width: 56px;
        height: 56px;
        border-radius: .9rem;
        background: #e7f1ff;
        color: #0d6efd;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 1rem;
    }
</style>

<div class="container py-4 py-md-5">

    <section class="home-hero text-center shadow-lg">
        <div class="home-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="44" height="44"
                 fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                <path d="M8.211 2.047a.5.5 0 0 0-.422 0l-7.5 3.5a.5.5 0 0 0 .025.917l7.5 3a.5.5 0 0 0 .372 0L14 7.14V13a1 1 0 0 0-1 1v2h3v-2a1 1 0 0 0-1-1V6.739l.686-.275a.5.5 0 0 0 .025-.917l-7.5-3.5Z" />
                <path d="M4.176 9.032a.5.5 0 0 0-.656.327l-.5 1.7a.5.5 0 0 0 .294.605l4.5 1.8a.5.5 0 0 0 .372 0l4.5-1.8a.5.5 0 0 0 .294-.605l-.5-1.7a.5.5 0 0 0-.656-.327L8 10.466 4.176 9.032Z" />
            </svg>
        </div>

        <h1 class="display-4 fw-bold">Educational Platform</h1>

        <p class="lead mt-3 mb-0 mx-auto" style="max-width: 560px; opacity: .92;">
            Welcome to our educational platform.
            Sign in to continue or create a student account.
        </p>

        <div class="mt-4 d-flex flex-wrap justify-content-center gap-2">
            <a asp-area="Identity"
               asp-page="/Account/Login"
               class="btn btn-light btn-lg home-btn text-primary">
                Login
            </a>

            <a asp-action="Create"
               asp-controller="Registration"
               class="btn btn-outline-light btn-lg home-btn">
                Register
            </a>
        </div>
    </section>

    <section class="row g-4 mt-4 text-center">
        <div class="col-12 col-md-4">
            <div class="card feature-card shadow-sm h-100">
                <div class="card-body p-4">
                    <div class="feature-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28"
                             fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                            <path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6zm2-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0zm4 8c0 1-1 1-1 1H3s-1 0-1-1 1-4 6-4 6 3 6 4zm-1-.004c-.001-.246-.154-.986-.832-1.664C11.516 10.68 10.289 10 8 10c-2.29 0-3.516.68-4.168 1.332-.678.678-.83 1.418-.832 1.664h10z" />
                        </svg>
                    </div>
                    <h5 class="fw-semibold">Easy Enrollment</h5>
                    <p class="text-muted mb-0">
                        Submit a registration request and wait for the administration to approve it.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="card feature-card shadow-sm h-100">
                <div class="card-body p-4">
                    <div class="feature-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28"
                             fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                            <path d="M5 4a.5.5 0 0 0 0 1h6a.5.5 0 0 0 0-1H5zm-.5 2.5A.5.5 0 0 1 5 6h6a.5.5 0 0 1 0 1H5a.5.5 0 0 1-.5-.5zM5 8a.5.5 0 0 0 0 1h6a.5.5 0 0 0 0-1H5zm0 2a.5.5 0 0 0 0 1h3a.5.5 0 0 0 0-1H5z" />
                            <path d="M2 2a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V2zm10-1H4a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1z" />
                        </svg>
                    </div>
                    <h5 class="fw-semibold">Posts &amp; Materials</h5>
                    <p class="text-muted mb-0">
                        Follow announcements and download files shared for your school year.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="card feature-card shadow-sm h-100">
                <div class="card-body p-4">
                    <div class="feature-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28"
                             fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                            <path d="M5.338 1.59a61.44 61.44 0 0 0-2.837.856.481.481 0 0 0-.328.39c-.554 4.157.726 7.19 2.253 9.188a10.725 10.725 0 0 0 2.287 2.233c.346.244.652.42.893.533.12.057.218.095.293.118a.55.55 0 0 0 .101.025.615.615 0 0 0 .1-.025c.076-.023.174-.061.294-.118.24-.113.547-.29.893-.533a10.726 10.726 0 0 0 2.287-2.233c1.527-1.997 2.807-5.031 2.253-9.188a.48.48 0 0 0-.328-.39c-.651-.213-1.75-.56-2.837-.855C9.552 1.29 8.531 1.067 8 1.067c-.53 0-1.552.223-2.662.524zM5.072.56C6.157.265 7.31 0 8 0s1.843.265 2.928.56c1.11.3 2.229.655 2.887.87a1.54 1.54 0 0 1 1.044 1.262c.596 4.477-.787 7.795-2.465 9.99a11.775 11.775 0 0 1-2.517 2.453 7.159 7.159 0 0 1-1.048.625c-.28.132-.581.24-.829.24s-.548-.108-.829-.24a7.158 7.158 0 0 1-1.048-.625 11.777 11.777 0 0 1-2.517-2.453C1.928 10.487.545 7.169 1.141 2.692A1.54 1.54 0 0 1 2.185 1.43 62.456 62.456 0 0 1 5.072.56z" />
                        </svg>
                    </div>
                    <h5 class="fw-semibold">Secure Access</h5>
                    <p class="text-muted mb-0">
                        Sign in with your account to reach content that belongs to your group.
                    </p>
                </div>
            </div>
        </div>
    </section>
</div>
