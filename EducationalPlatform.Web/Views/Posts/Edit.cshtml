@model EducationalPlatform.ViewModels.PostEditViewModel

@{
    ViewData["Title"] = "Edit Post";
}

<h2>Edit Post</h2>

<form asp-action="Edit"
      asp-route-id="@Model.Id"
      asp-route-returnYearId="@ViewBag.ReturnYearId"
      method="post"
      enctype="multipart/form-data">

    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label asp-for="YearId" class="form-label"></label>
        <select asp-for="YearId"
                asp-items="ViewBag.Years"
                class="form-select"></select>
        <span asp-validation-for="YearId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Title" class="form-label"></label>
        <input asp-for="Title" class="form-control" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Content" class="form-label"></label>
        <textarea asp-for="Content" class="form-control" rows="8"></textarea>
        <span asp-validation-for="Content" class="text-danger"></span>
    </div>

    @if (Model.ExistingAttachments.Any())
    {
        <div class="mb-3">
            <label class="form-label">Current Attachments</label>

            <ul class="list-group">
                @foreach (var attachment in Model.ExistingAttachments)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <a href="@attachment.FilePath"
                           target="_blank"
                           rel="noopener noreferrer">
                            @attachment.FileName
                        </a>

                        <div class="form-check">
                            <input class="form-check-input"
                                   type="checkbox"
                                   name="RemoveAttachmentIds"
                                   value="@attachment.Id"
                                   id="remove_@attachment.Id"
                            @(Model.RemoveAttachmentIds.Contains(attachment.Id) ? "checked" : "") />
                            <label class="form-check-label text-danger"
                                   for="remove_@attachment.Id">
                                Remove
                            </label>
                        </div>
                    </li>
                }
            </ul>
        </div>
    }

    <div class="mb-3">
        <label asp-for="Files" class="form-label">Add New Attachments</label>
        <input asp-for="Files" type="file" class="form-control" multiple />
        <div class="form-text">
            Maximum 100 MB per file. Allowed: images, videos, PDF, Office files, TXT, ZIP.
        </div>
        <span asp-validation-for="Files" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Save Changes</button>

    <a asp-action="Index"
       asp-route-yearId="@ViewBag.ReturnYearId"
       class="btn btn-secondary">
        Cancel
    </a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
