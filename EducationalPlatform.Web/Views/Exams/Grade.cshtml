@model EducationalPlatform.ViewModels.GradeExamViewModel
@{ ViewData["Title"] = "Exam results"; }
<div class="container py-4"><h1>Exam results</h1><p class="text-muted">@Model.ExamTitle · @Model.YearName / @Model.GroupName · Maximum @Model.MaximumGrade</p><form asp-action="Grade" method="post"><input asp-for="AssignmentId" type="hidden"/><div asp-validation-summary="All" class="text-danger"></div><div class="table-responsive"><table class="table table-striped align-middle"><thead><tr><th>Student</th><th>Score (blank keeps existing score)</th></tr></thead><tbody>@for(var i=0;i<Model.Students.Count;i++){<tr><td>@Model.Students[i].FullName<input asp-for="Students[i].StudentId" type="hidden"/></td><td><input asp-for="Students[i].Score" class="form-control" type="number" min="0" max="@Model.MaximumGrade" step="0.01"/></td></tr>}@if(!Model.Students.Any()){<tr><td colspan="2" class="text-muted text-center">No active students in this group.</td></tr>}</tbody></table></div><button class="btn btn-primary">Save results</button> <a asp-action="Assignments" class="btn btn-outline-secondary">Back</a></form></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
