@model EducationalPlatform.ViewModels.AssignExamViewModel
@{ ViewData["Title"] = "Assign exam"; }
<div class="container py-4"><h1>Assign exam</h1><p class="text-muted">@Model.ExamTitle</p><form asp-action="Assign" method="post" class="card card-body gap-3"><input asp-for="ExamId" type="hidden"/><input asp-for="ExamTitle" type="hidden"/><div asp-validation-summary="All" class="text-danger"></div><div><label asp-for="YearId" class="form-label"></label><select asp-for="YearId" asp-items="Model.Years" class="form-select" id="yearSelect"><option value="">Choose year</option></select><span asp-validation-for="YearId" class="text-danger"></span></div><div><label asp-for="GroupId" class="form-label"></label><select asp-for="GroupId" asp-items="Model.Groups" class="form-select" id="groupSelect"><option value="">Choose group</option></select><span asp-validation-for="GroupId" class="text-danger"></span></div><div><label asp-for="ExamDate" class="form-label">Exam date</label><input asp-for="ExamDate" type="date" class="form-control"/><span asp-validation-for="ExamDate" class="text-danger"></span></div><div><label asp-for="StartTime" class="form-label">Start time</label><input asp-for="StartTime" type="time" class="form-control" value="@Model.StartTime.ToString(@"hh\:mm")"/></div><div><label asp-for="EndTime" class="form-label">End time</label><input asp-for="EndTime" type="time" class="form-control" value="@Model.EndTime.ToString(@"hh\:mm")"/></div><div><button class="btn btn-primary">Assign exam</button> <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a></div></form></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /><script>document.getElementById('yearSelect').addEventListener('change', async function(){ const group=document.getElementById('groupSelect'); group.innerHTML='<option value="">Choose group</option>'; if(!this.value)return; const response=await fetch('@Url.Action("GetGroupsByYear", "Exams")?yearId='+encodeURIComponent(this.value)); if(!response.ok)return; for(const item of await response.json()){const option=document.createElement('option');option.value=item.id;option.textContent=item.name;group.appendChild(option);} });</script> }
