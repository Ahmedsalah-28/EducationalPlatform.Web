@model EducationalPlatform.ViewModels.ExamFormViewModel
@{ ViewData["Title"] = "Create exam"; }
<div class="container py-4"><h1>Create exam</h1><form asp-action="Create" method="post" class="card card-body gap-3"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div><label asp-for="Title" class="form-label"></label><input asp-for="Title" class="form-control"/><span asp-validation-for="Title" class="text-danger"></span></div><div><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="3"></textarea><span asp-validation-for="Description" class="text-danger"></span></div><div><label asp-for="MaximumGrade" class="form-label">Maximum grade</label><input asp-for="MaximumGrade" class="form-control"/><span asp-validation-for="MaximumGrade" class="text-danger"></span></div><div><label asp-for="PassingPercentage" class="form-label">Passing percentage</label><input asp-for="PassingPercentage" class="form-control"/><span asp-validation-for="PassingPercentage" class="text-danger"></span></div><div><button class="btn btn-primary">Save exam</button> <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a></div></form></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
