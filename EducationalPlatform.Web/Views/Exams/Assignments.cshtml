@model IEnumerable<EducationalPlatform.ViewModels.ExamAssignmentListItem>
@{ ViewData["Title"] = "Exam assignments"; }
<div class="container py-4"><div class="d-flex justify-content-between align-items-center mb-3"><div><h1>Exam schedule &amp; grades</h1><p class="text-muted">Assignments for your assigned groups.</p></div><a class="btn btn-outline-secondary" asp-action="Index">Exams</a></div><partial name="_YearGroupFilter" model="Model.Count()" /><div class="table-responsive"><table class="table table-striped align-middle"><thead><tr><th>Exam</th><th>Year / group</th><th>Date</th><th>Time</th><th>Results</th><th></th></tr></thead><tbody>@foreach(var a in Model){<tr><td>@a.ExamTitle<div class="small text-muted">Max: @a.MaximumGrade</div></td><td>@a.YearName / @a.GroupName</td><td>@a.ExamDate.ToString("dd MMM yyyy")</td><td>@DateTime.Today.Add(a.StartTime).ToString("hh:mm tt") - @DateTime.Today.Add(a.EndTime).ToString("hh:mm tt")</td><td>@a.GradedCount / @a.StudentCount</td><td><a class="btn btn-sm btn-primary" asp-action="Grade" asp-route-id="@a.Id">Enter grades</a></td></tr>}@if(!Model.Any()){<tr><td colspan="6" class="text-center text-muted">No exam assignments found.</td></tr>}</tbody></table></div></div>
