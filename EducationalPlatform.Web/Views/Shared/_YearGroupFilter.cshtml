@using Microsoft.AspNetCore.Mvc.Rendering
@model int

<form method="get" class="card card-body mb-4">
    <div class="row g-3 align-items-end">
        <div class="col-md-4">
            <label for="yearId" class="form-label">Year</label>
            <select id="yearId" name="yearId" class="form-select"
                    asp-items="(SelectList)ViewBag.Years"
                    onchange="document.getElementById('groupId').value = ''; this.form.submit();">
                <option value="">All years</option>
            </select>
        </div>

        <div class="col-md-4">
            <label for="groupId" class="form-label">Group</label>
            <select id="groupId" name="groupId" class="form-select"
                    asp-items="(SelectList)ViewBag.Groups"
                    onchange="this.form.submit();">
                <option value="">All groups</option>
            </select>
        </div>

        <div class="col-md-4">
            <a href="@Context.Request.Path" class="btn btn-outline-secondary">Clear filters</a>
            <span class="text-muted ms-2">@Model result(s)</span>
        </div>
    </div>
</form>
