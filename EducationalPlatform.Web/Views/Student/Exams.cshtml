@model IEnumerable<EducationalPlatform.ViewModels.StudentExamRow>
@{
    ViewData["Title"] = "My Exams";
    string Badge(string status) => status switch
    {
        "Passed" or "Graded" => "bg-success",
        "Failed" or "Missed" => "bg-danger",
        "Open" or "In progress" => "bg-primary",
        "Upcoming" => "bg-info text-dark",
        _ => "bg-secondary"
    };

    string ScoreText(decimal? score, decimal max) =>
        score.HasValue && max > 0 ? $"{score.Value:0.##} / {max:0.##}" : "—";
}

<section class="ad-welcome">
    <h1>My Exams</h1>
    <p>Your exam schedule and the scores you received.</p>
</section>

<section class="ad-panel">
    @if (!Model.Any())
    {
        <p class="ad-empty">No exams have been assigned to you yet.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped align-middle mb-0">
                <thead>
                    <tr>
                        <th>Exam</th>
                        <th>Date</th>
                        <th>Time</th>
                        <th>Pass %</th>
                        <th>My Score</th>
                        <th>Result</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var e in Model)
                    {
                        <tr>
                            <td>
                                <strong>@e.Title</strong>
                                @if (!string.IsNullOrWhiteSpace(e.Description))
                                {
                                    <div class="small text-muted">@e.Description</div>
                                }
                            </td>
                            <td>@e.Date.ToString("dd MMM yyyy")</td>
                            <td>@DateTime.Today.Add(e.StartTime).ToString("hh:mm tt") - @DateTime.Today.Add(e.EndTime).ToString("hh:mm tt")</td>
                            <td>@e.PassingPercentage.ToString("0.##")%</td>
                            <td><strong>@ScoreText(e.Score, e.MaxScore)</strong></td>
                            <td><span class="badge @Badge(e.Status)">@e.Status</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
