@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();

    var staffControllers = new[]
    {
        "Admin", "Years", "Groups", "Students", "Assistants", "GroupSchedules",
        "ClassSessions", "Attendance", "Trainings", "Exams", "Quizzes",
        "RegistrationRequests", "Posts"
    };

    if (staffControllers.Contains(currentController))
    {
        Layout = User.IsInRole("Admin") ? "_AdminLayout" : "_AssistantLayout";
    }
    else
    {
        Layout = "_Layout";
    }
}
