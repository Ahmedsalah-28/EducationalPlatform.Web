@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();

    var staffControllers = new[]
    {
        "Admin", "Years", "Groups", "Students", "Assistants", "GroupSchedules",
        "ClassSessions", "Attendance", "Trainings", "Exams", "Quizzes",
        "RegistrationRequests", "Posts"
    };

    if (staffControllers.Contains(currentController))
    {
        Layout = User.IsInRole("Admin") ? "_AdminLayout" : "_AssistantLayout";
    }
    else if (currentController == "Chat" || currentController == "Notifications")
    {
        // Chat is shared: each role keeps its own sidebar.
        Layout = User.IsInRole("Student") ? "_StudentLayout"
               : User.IsInRole("Admin") ? "_AdminLayout"
               : "_AssistantLayout";
    }
    else if (currentController == "Student" && User.IsInRole("Student"))
    {
        Layout = "_StudentLayout";
    }
    else
    {
        Layout = "_Layout";
    }
}
