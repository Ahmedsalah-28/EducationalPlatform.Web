@model IEnumerable<EducationalPlatform.Models.Year>

@{
    ViewData["Title"] = "Browse Schedules by Year";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Browse Schedules by Year</h2>

        <a asp-action="Index"
           class="btn btn-outline-secondary">
            View All Schedules
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No academic years found.
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var year in Model)
            {
                <div class="col-md-4 mb-3">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body">
                            <h5 class="card-title">
                                @year.Name
                            </h5>

                            <p class="text-muted">
                                @(year.Description ?? "No description")
                            </p>

                            <a asp-action="ByYear"
                               asp-route-id="@year.Id"
                               class="btn btn-primary">
                                View Schedules
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <a asp-controller="Admin"
       asp-action="Index"
       class="btn btn-secondary mt-2">
        Back to Dashboard
    </a>

</div>