@model IEnumerable<EducationalPlatform.Models.GroupSchedule>

@{
    ViewData["Title"] = "Schedules by Year";
    int yearId = (int)ViewBag.SelectedYearId;
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Schedules - @ViewBag.SelectedYearName</h2>

        <div>
            <a asp-action="Browse"
               class="btn btn-outline-secondary">
                Back to Years
            </a>

            <a asp-action="Index"
               class="btn btn-outline-primary">
                View All Schedules
            </a>

            <a asp-action="Create"
               asp-route-yearId="@yearId"
               class="btn btn-primary">
                + Add Schedule
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No schedules have been created for this year yet.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>Group</th>
                        <th>Day</th>
                        <th>Start Time</th>
                        <th>End Time</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var schedule in Model)
                    {
                        <tr>
                            <td>@schedule.Group.Name</td>
                            <td>@schedule.DayOfWeek</td>
                            <td>@schedule.StartTime.ToString(@"hh\:mm")</td>
                            <td>@schedule.EndTime.ToString(@"hh\:mm")</td>

                            <td>
                                @if (schedule.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                            </td>

                            <td>
                                <a asp-action="Edit"
                                   asp-route-id="@schedule.Id"
                                   asp-route-yearId="@yearId"
                                   class="btn btn-sm btn-outline-primary">
                                    Edit
                                </a>

                                @if (schedule.IsActive)
                                {
                                    <form asp-action="Deactivate"
                                          asp-route-id="@schedule.Id"
                                          asp-route-yearId="@yearId"
                                          method="post"
                                          class="d-inline"
                                          onsubmit="return confirm('Deactivate this schedule?');">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="btn btn-sm btn-outline-danger">
                                            Deactivate
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <a asp-controller="Admin"
       asp-action="Index"
       class="btn btn-secondary">
        Back to Dashboard
    </a>

</div>