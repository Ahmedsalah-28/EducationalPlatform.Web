@model IEnumerable<EducationalPlatform.Models.Training>

@{
    ViewData["Title"] = "Trainings";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Trainings</h1>

    <div>
        <a asp-action="Assignments" class="btn btn-outline-primary me-2">Assignments &amp; Grades</a>
        <a asp-action="Create" class="btn btn-primary">Add Training</a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">No trainings yet. Add your first training.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-bordered table-striped align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Title</th>
                    <th>Type</th>
                    <th>Max Grade</th>
                    <th>Assigned</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in Model)
                {
                    <tr>
                        <td>
                            @t.Title
                            @if (!string.IsNullOrWhiteSpace(t.Description))
                            {
                                <div class="text-muted small">@t.Description</div>
                            }
                        </td>
                        <td>
                            <span class="badge @(t.Type == "Online" ? "bg-info text-dark" : "bg-secondary")">
                                @(t.Type == "InClass" ? "In-Class" : t.Type)
                            </span>
                        </td>
                        <td>@t.MaximumGrade.ToString("0.##")</td>
                        <td>@t.TrainingAssignments.Count time(s)</td>
                        <td>
                            <a asp-action="Assign" asp-route-id="@t.Id" class="btn btn-sm btn-success">Assign</a>
                            <a asp-action="Edit" asp-route-id="@t.Id" class="btn btn-sm btn-warning">Edit</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
