@model EducationalPlatform.ViewModels.GradeTrainingViewModel

@{
    ViewData["Title"] = "Grade Training";
}

<h2>Grade Training</h2>

<div class="card mb-3">
    <div class="card-body">
        <p class="mb-1"><strong>Training:</strong> @Model.TrainingTitle</p>
        <p class="mb-1"><strong>Year:</strong> @Model.YearName</p>
        <p class="mb-1"><strong>Group:</strong> @Model.GroupName</p>
        <p class="mb-1"><strong>Date:</strong> @Model.AssignedDate.ToString("yyyy-MM-dd")</p>
        <p class="mb-0"><strong>Maximum grade:</strong> @Model.MaxGrade.ToString("0.##")</p>
    </div>
</div>

@if (Model.Students.Count == 0)
{
    <div class="alert alert-warning">No active students are enrolled in this group.</div>
    <a asp-action="Assignments" class="btn btn-secondary">Back</a>
}
else
{
    <form asp-action="Grade" method="post">
        <input type="hidden" asp-for="AssignmentId" />

        <div asp-validation-summary="All" class="text-danger mb-3"></div>

        <table class="table table-bordered align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Student</th>
                    <th style="width: 220px;">Grade (out of @Model.MaxGrade.ToString("0.##"))</th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < Model.Students.Count; i++)
                {
                    <tr>
                        <td>
                            @Model.Students[i].FullName
                            <input type="hidden" asp-for="Students[i].StudentId" />
                        </td>
                        <td>
                            <input asp-for="Students[i].Score"
                                   type="number" step="0.01" min="0" max="@Model.MaxGrade"
                                   class="form-control" />
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <p class="text-muted small">Leave a field empty to skip that student.</p>

        <button type="submit" class="btn btn-success">Save Grades</button>
        <a asp-action="Assignments" class="btn btn-secondary">Back</a>
    </form>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
