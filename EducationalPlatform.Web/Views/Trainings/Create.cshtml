@model EducationalPlatform.ViewModels.TrainingViewModel

@{
    ViewData["Title"] = "Add Training";
}

<div class="row">
    <div class="col-md-8">
        <h1 class="mb-4">Add Training</h1>

        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <partial name="_TrainingFields" model="Model" />

            <button type="submit" class="btn btn-primary">Create Training</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
