@model IEnumerable<EducationalPlatform.ViewModels.TrainingAssignmentListItem>

@{
    ViewData["Title"] = "Training Assignments";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Training Assignments</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">Trainings</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<partial name="_YearGroupFilter" model="Model.Count()" />

@if (!Model.Any())
{
    <div class="alert alert-info">No training assignments found.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-bordered table-striped align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Training</th>
                    <th>Type</th>
                    <th>Year</th>
                    <th>Group</th>
                    <th>Date</th>
                    <th>Graded</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in Model)
                {
                    <tr>
                        <td>@a.TrainingTitle <span class="text-muted small">(max @a.MaxGrade.ToString("0.##"))</span></td>
                        <td>@(a.TrainingType == "InClass" ? "In-Class" : a.TrainingType)</td>
                        <td>@a.YearName</td>
                        <td>@a.GroupName</td>
                        <td>@a.AssignedDate.ToString("yyyy-MM-dd")</td>
                        <td>@a.GradedCount / @a.StudentCount</td>
                        <td>
                            <a asp-action="Grade" asp-route-id="@a.Id" class="btn btn-sm btn-success">Grade</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
