@model IEnumerable<EducationalPlatform.Models.RegistrationRequest>

@{
    ViewData["Title"] = "Registration Requests";
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<h2>Registration Requests</h2>

<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Full Name</th>
                <th>Email</th>
                <th>Phone</th>
                <th>Year</th>
                <th>Group</th>
                <th>Status</th>
                <th>Actions</th>
                <th>Submitted At</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var request in Model)
            {
                <tr>
                    <td>@request.FullName</td>
                    <td>@request.Email</td>
                    <td>@request.Phone</td>
                    <td>@request.RequestedGroup.Year.Name</td>
                    <td>@request.RequestedGroup.Name</td>
                    <td>
                        @if (request.Status == "Pending")
                        {
                            <span class="badge bg-warning text-dark">
                                Pending
                            </span>
                        }
                        else if (request.Status == "Approved")
                        {
                            <span class="badge bg-success">
                                Approved
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger">
                                Rejected
                            </span>
                        }
                    </td>

                    <td>
                        @if (request.Status == "Pending")
                        {
                            <a asp-action="Review"
                               asp-route-id="@request.Id"
                               class="btn btn-sm btn-success mb-1">
                                Review / Approve
                            </a>

                            <form asp-action="Reject"
                                  asp-route-id="@request.Id"
                                  method="post"
                                  class="d-inline"
                                  onsubmit="return confirm('Are you sure you want to reject this request?');">

                                <button type="submit"
                                        class="btn btn-sm btn-danger mb-1">
                                    Reject
                                </button>
                            </form>
                        }
                        else
                        {
                            <span class="text-muted">Reviewed</span>
                        }
                    </td>
                    <td>@request.SubmittedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (!Model.Any())
{
    <p class="text-muted">No registration requests found.</p>
}

<a asp-controller="Admin"
   asp-action="Index"
   class="btn btn-secondary">
    Back to Dashboard
</a>